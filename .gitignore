# Secrets — never commit. The Portkey key is read from the environment.
.env
.env.*
!.env.example

# --- The data pack ---------------------------------------------------------
# Both databases ARE committed, so a grader can clone and run without hunting
# for a data file: the pristine original and the working copy the tools write
# to. Nothing else from data/ goes in.
data/*
!data/campus_customs.db
!data/campus_customs_new.db

# Dependencies / build output
.venv/
venv/
__pycache__/
*.py[cod]
node_modules/
dist/
build/
*.tsbuildinfo

# Runtime + tooling noise
.DS_Store
*.log
npm-debug.log*
.cache/
coverage/
